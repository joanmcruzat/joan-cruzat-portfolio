# Resend
# Create these in Vercel Project Settings -> Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
JOAN_EMAIL=joanmcruzat@gmail.com
RESEND_FROM=Joan Cruzat <onboarding@resend.dev>

# For production, verify your own domain in Resend and use:
# RESEND_FROM=Joan Cruzat <hello@yourdomain.com>

# Claude (AI chat assistant, /api/chat)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx

# Optional: use Ollama instead of Claude (local: http://localhost:11434, cloud: https://ollama.com)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_API_KEY=   # only for Ollama Cloud

# Supabase (added automatically by the Vercel Supabase integration; pull with `npx vercel env pull .env.local`).
# `vercel dev` reads only .env, so copy SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY into .env as well.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Owner connection, used locally by `npm run db:migrate` / `npm run db:seed` only
POSTGRES_URL_NON_POOLING=postgres://postgres:xxxxxxxx@db.xxxxxxxx.supabase.co:5432/postgres
